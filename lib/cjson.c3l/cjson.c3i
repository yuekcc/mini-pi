extern fn CJsonItem* create_object_reference(CJsonItem* child) @cname("cJSON_CreateObjectReference");
extern fn CJsonItem* create_array_reference(CJsonItem* child) @cname("cJSON_CreateArrayReference");

extern fn CJsonItem* create_int_array(int *numbers, int count) @cname("cJSON_CreateIntArray");
