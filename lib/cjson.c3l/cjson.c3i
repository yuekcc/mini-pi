module cjson;

import std::io;

const int INVALID = 0; // cJSON_Invalid
const int FALSE = (1 << 0);
const int TRUE = (1 << 1);
const int NULL = (1 << 2);
const int NUMBER = (1 << 3);
const int STRING = (1 << 4);
const int ARRAY = (1 << 5);
const int OBJECT = (1 << 6);
const int RAW = (1 << 7); // raw json

const int IS_REFERENCE = 256;
const int STRING_IS_CONST = 512;

const int VERSION_MAJOR = 1;
const int VERSION_MINOR = 7;
const int VERSION_PATCH = 19;

const int NESTING_LIMIT = 1000;
const int CIRCULAR_LIMIT = 10000;

struct CJsonItem (Printable)
{
    CJsonItem* next;
    CJsonItem* prev;
    CJsonItem* child;
    int type;
    char* valuestring;
    int valueint;
    double valuedouble;
    char* string;
}

alias MallocFn = fn void* (usz size);
alias FreeFn = fn void (void* ptr);

// 注意：c3 的 fn 类型本身就是指针（对应 C 的 void*(*)(size_t)），
// 字段不能再用 * 修饰（否则成双指针，赋值经局部变量取址会悬垂）。
struct Hook
{
   MallocFn malloc_fn;
   FreeFn free_fn;
}

extern fn ZString version() @cname("cJSON_Version");
extern fn void init_hooks(Hook *hook) @cname("cJSON_InitHooks");
extern fn CJsonItem* parse(ZString str) @cname("cJSON_Parse");
extern fn CJsonItem* parse_with_length(ZString str, usz buffer_size) @cname("cJSON_ParseWithLength");
extern fn CJsonItem* parse_with_opts(ZString str, ZString[] return_parse_end, bool require_null_terminated) @cname("cJSON_ParseWithOpts");
extern fn CJsonItem* parse_with_length_opts(ZString str, usz buffer_size, ZString[] return_parse_end, bool require_null_terminated) @cname("cJSON_ParseWithLengthOpts");

extern fn ZString print(CJsonItem* item) @cname("cJSON_Print");
extern fn ZString print_unformatted(CJsonItem* item) @cname("cJSON_PrintUnformatted");
extern fn ZString print_buffered(CJsonItem* item, int prebuffer, bool fmt) @cname("cJSON_PrintBuffered");
extern fn bool print_preallocated(CJsonItem* item, char *buffer, int length, bool format) @cname("cJSON_PrintPreallocated");
extern fn void delete(CJsonItem* item) @cname("cJSON_Delete");

extern fn int get_array_size(CJsonItem* array) @cname("cJSON_GetArraySize");
extern fn CJsonItem* get_array_item(CJsonItem* array, int index) @cname("cJSON_GetArrayItem");
extern fn CJsonItem* get_object_item(CJsonItem* object, ZString string) @cname("cJSON_GetObjectItem");
extern fn CJsonItem* get_object_item_case_sensitive(CJsonItem* object, ZString string) @cname("cJSON_GetObjectItemCaseSensitive");
extern fn bool has_object_item(CJsonItem* object, ZString string) @cname("cJSON_HasObjectItem");
extern fn ZString get_error_ptr() @cname("cJSON_GetErrorPtr");

extern fn ZString get_string_value(CJsonItem* item) @cname("cJSON_GetStringValue");
extern fn double get_number_value(CJsonItem* item) @cname("cJSON_GetNumberValue");

extern fn bool is_invalid(CJsonItem* item) @cname("cJSON_IsInvalid");
extern fn bool is_false(CJsonItem* item) @cname("cJSON_IsFalse");
extern fn bool is_true(CJsonItem* item) @cname("cJSON_IsTrue");
extern fn bool is_bool(CJsonItem* item) @cname("cJSON_IsBool");
extern fn bool is_null(CJsonItem* item) @cname("cJSON_IsNull");
extern fn bool is_number(CJsonItem* item) @cname("cJSON_IsNumber");
extern fn bool is_string(CJsonItem* item) @cname("cJSON_IsString");
extern fn bool is_array(CJsonItem* item) @cname("cJSON_IsArray");
extern fn bool is_object(CJsonItem* item) @cname("cJSON_IsObject");
